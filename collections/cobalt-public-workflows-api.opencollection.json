{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobalt Applications Public Workflows API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Public Workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cobalt Create Public Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gocobalt.io/api/v2/public/workflow",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Creates a new public workflow with the specified nodes."
        },
        {
          "info": {
            "name": "Cobalt Execute Workflow",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gocobalt.io/api/v2/public/workflow/:workflow_id/execute",
            "headers": [
              {
                "name": "linked_account_id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflow_id",
                "value": "",
                "type": "path",
                "description": "The workflow ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Executes a specific workflow programmatically."
        }
      ]
    }
  ],
  "bundled": true
}