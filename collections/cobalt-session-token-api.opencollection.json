{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobalt Applications Session Token API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Session Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Cobalt Generate Token for Linked Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gocobalt.io/api/v2/public/session-token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generates a session token for a linked account. Session tokens expire in 24 hours and are used to authenticate client-side SDK calls."
        }
      ]
    }
  ],
  "bundled": true
}